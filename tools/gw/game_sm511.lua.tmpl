-- @TITLE@: generated from the MAME romset by build_mgw.py (SM511/SM512).
-- Chip is a Lua port of MAME's SM511 core; segments from the romset SVG.
-- Sound is the chip's own melody controller: each frame asks the core
-- what note its melody ROM is playing and gates the matching square.

local sm511 = system.loadunit 'sm511'

-- K is the OR of the columns S has selected, plus the fixed column when
-- the driver ties one on. The two test pins are unpopulated cheat
-- jumpers on most units and a joystick on a few, with the polarity
-- given per game.
local cols = { @COLS_INIT@ }
local MUXCOLS, FIXED = @MUXCOLS@, @FIXED@
local strobe = 0
local redges = 0
local ba, b = @BA_IDLE@, @B_IDLE@

local cpu = sm511.new{
  rom = system.loadbin 'rom.bin',
  melody = system.loadbin 'melody.bin',
  chip = '@CHIP@',
  read_ba = function() return ba end,
  read_b  = function() return b end,
  write_s = function( s ) strobe = s end,
  read_k  = function()
    local k = 0
    for i = 1, MUXCOLS do
      if (strobe & (1 << (i - 1))) ~= 0 then k = k | cols[ i ] end
    end
    if FIXED ~= 0 then k = k | cols[ FIXED ] end
    return k
  end,
  write_r = function( out ) redges = redges + 1 end,
}
cpu:reset()

-- one looped square per melody note the chip can produce
local NOTES = {
@NOTES@
}
local sounds = {}
for i = 1, #NOTES do
  local snd = system.newsound()
  snd.data = system.loadbin( NOTES[ i ][ 2 ] )
  snd.loop = true
  sounds[ i ] = snd
end
local playing = nil

local bgimg = system.newimage()
bgimg.picture.data = system.loadbin 'background.rle'
system.setbackground( bgimg.picture )
bgimg.picture = nil
bgimg.visible = false

-- one origin per screen; single-screen units have one entry
local LCDS = {
@LCDS@
}
local segdefs = {
@SEGDEFS@
}
local segimgs = {}
for i = 1, #segdefs do
  local d = segdefs[ i ]
  local o = LCDS[ d[ 5 ] ]
  local img = system.newimage()
  img.picture.data = system.loadbin( d[ 4 ] )
  img.left = o[ 1 ] + d[ 2 ]
  img.top  = o[ 2 ] + d[ 3 ]
  img.visible = false
  segimgs[ i ] = img
end

local BTN = {
@BUTTONMAP@
}
local tapzones = {
@TAPZONES@
}

local CYCLES_PER_FRAME = 16384 / 60
local acc = 0
local newstate = {}

local held = {}

local function press( action )
  held[ action ] = true
  local d = BTN[ action ]
  if d then cols[ d[ 1 ] ] = cols[ d[ 1 ] ] | d[ 2 ] end
end

return function()
  if not system.issoundactive() then system.resumesounds() end
  system.inputstate( newstate )

  for i = 1, #cols do cols[ i ] = 0 end
  for k in pairs( held ) do held[ k ] = nil end
@PRESSES@
  if newstate.pointer_pressed then
    local px, py = newstate.pointer_x, newstate.pointer_y
    for i = 1, #tapzones do
      local z = tapzones[ i ]
      if px >= z[1] and px < z[1]+z[3] and py >= z[2] and py < z[2]+z[4] then
        press( z[ 5 ] ); break
      end
    end
  end

@PINS@
  redges = 0
  acc = acc + CYCLES_PER_FRAME
  local n = acc // 1
  acc = acc - n
  cpu:run( n )

  -- melody: match the chip's current note to the nearest sample
  local hz = cpu:melody_hz()
  local want = nil
  if hz then
    local best = 1e9
    for i = 1, #NOTES do
      local d = math.abs( NOTES[ i ][ 1 ] - hz )
      if d < best then best = d; want = i end
    end
  end
  if want ~= playing then
    if playing then system.stopsounds( -1 ) end
    if want then system.playsound( sounds[ want ], -1 ) end
    playing = want
  end

  local segset = cpu:segments()
  for i = 1, #segdefs do
    segimgs[ i ].visible = segset[ segdefs[ i ][ 1 ] ] == true
  end

  return true
end
