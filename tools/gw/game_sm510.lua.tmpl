-- @TITLE@: generated from the MAME romset by build_mgw.py (SM510).
-- Chip is a Lua port of MAME's SM510 core; segments from the romset SVG.

local sm510 = system.loadunit 'sm510'

-- K is the OR of the columns S has selected, plus the fixed column when
-- the driver ties one on. The two test pins are unpopulated cheat
-- jumpers on most units and a joystick on a few, with the polarity
-- given per game.
local cols = { @COLS_INIT@ }
local MUXCOLS, FIXED = @MUXCOLS@, @FIXED@
local strobe = 0
local redges = 0
local ba, b = @BA_IDLE@, @B_IDLE@

local cpu = sm510.new{
  rom = system.loadbin 'rom.bin',
  read_ba = function() return ba end,
  read_b  = function() return b end,
  write_s = function( s ) strobe = s end,
  read_k  = function()
    local k = 0
    for i = 1, MUXCOLS do
      if (strobe & (1 << (i - 1))) ~= 0 then k = k | cols[ i ] end
    end
    if FIXED ~= 0 then k = k | cols[ FIXED ] end
    return k
  end,
  write_r = function( out ) redges = redges + 1 end,
}
cpu:reset()

local snd = system.newsound()
snd.data = system.loadbin 'sq2048.pcm'
snd.loop = true
local buzzing = false

local bgimg = system.newimage()
bgimg.picture.data = system.loadbin 'background.rle'
system.setbackground( bgimg.picture )
bgimg.picture = nil
bgimg.visible = false

-- one origin per screen; single-screen units have one entry
local LCDS = {
@LCDS@
}
local segdefs = {
@SEGDEFS@
}
local segimgs = {}
for i = 1, #segdefs do
  local d = segdefs[ i ]
  local o = LCDS[ d[ 5 ] ]
  local img = system.newimage()
  img.picture.data = system.loadbin( d[ 4 ] )
  img.left = o[ 1 ] + d[ 2 ]
  img.top  = o[ 2 ] + d[ 3 ]
  img.visible = false
  segimgs[ i ] = img
end

local BTN = {
@BUTTONMAP@
}
local tapzones = {
@TAPZONES@
}

local CYCLES_PER_FRAME = 16384 / 60
local acc = 0
local newstate = {}

local held = {}

local function press( action )
  held[ action ] = true
  local d = BTN[ action ]
  if d then cols[ d[ 1 ] ] = cols[ d[ 1 ] ] | d[ 2 ] end
end

return function()
  if not system.issoundactive() then system.resumesounds() end
  system.inputstate( newstate )

  for i = 1, #cols do cols[ i ] = 0 end
  for k in pairs( held ) do held[ k ] = nil end
@PRESSES@
  if newstate.pointer_pressed then
    local px, py = newstate.pointer_x, newstate.pointer_y
    for i = 1, #tapzones do
      local z = tapzones[ i ]
      if px >= z[1] and px < z[1]+z[3] and py >= z[2] and py < z[2]+z[4] then
        press( z[ 5 ] ); break
      end
    end
  end

@PINS@
  redges = 0
  acc = acc + CYCLES_PER_FRAME
  local n = acc // 1
  acc = acc - n
  cpu:run( n )

  if redges >= 4 then
    if not buzzing then system.playsound( snd, -1 ); buzzing = true end
  elseif buzzing then
    system.stopsounds( -1 ); buzzing = false
  end

  local segset = cpu:segments()
  for i = 1, #segdefs do
    segimgs[ i ].visible = segset[ segdefs[ i ][ 1 ] ] == true
  end

  return true
end
