-- @TITLE@: generated from the MAME romset by build_mgw.py (SM510).
-- Chip is a Lua port of MAME's SM510 core; segments from the romset SVG.

local sm510 = system.loadunit 'sm510'

local cols = { @COLS_INIT@ }        -- current pressed bits per input column
local strobe = 0
local redges = 0

local cpu = sm510.new{
  rom = system.loadbin 'rom.bin',
  read_ba = function() return 1 end,   -- cheat pins: off
  read_b  = function() return 1 end,
  write_s = function( s ) strobe = s end,
  read_k  = function()
    local k = 0
    for i = 1, #cols do
      if (strobe & (1 << (i - 1))) ~= 0 then k = k | cols[ i ] end
    end
    return k
  end,
  write_r = function( out ) redges = redges + 1 end,
}
cpu:reset()

local snd = system.newsound()
snd.data = system.loadbin 'sq2048.pcm'
snd.loop = true
local buzzing = false

local bgimg = system.newimage()
bgimg.picture.data = system.loadbin 'background.rle'
system.setbackground( bgimg.picture )
bgimg.picture = nil
bgimg.visible = false

local LCD_X, LCD_Y = @LCD_X@, @LCD_Y@
local segdefs = {
@SEGDEFS@
}
local segimgs = {}
for i = 1, #segdefs do
  local d = segdefs[ i ]
  local img = system.newimage()
  img.picture.data = system.loadbin( d[ 4 ] )
  img.left = LCD_X + d[ 2 ]
  img.top  = LCD_Y + d[ 3 ]
  img.visible = false
  segimgs[ i ] = img
end

local BTN = {
@BUTTONMAP@
}
local tapzones = {
@TAPZONES@
}

local CYCLES_PER_FRAME = 16384 / 60
local acc = 0
local newstate = {}

local function press( action )
  local b = BTN[ action ]
  if b then cols[ b[ 1 ] + 1 ] = cols[ b[ 1 ] + 1 ] | b[ 2 ] end
end

return function()
  if not system.issoundactive() then system.resumesounds() end
  system.inputstate( newstate )

  for i = 1, #cols do cols[ i ] = 0 end
  if newstate.up or newstate.b then press( 'up' ) end
  if newstate.down or newstate.a then press( 'down' ) end
  if newstate.y or newstate.x then press( 'hit' ) end
  if newstate.l1 or newstate.start then press( 'gamea' ) end
  if newstate.r1 then press( 'gameb' ) end
  if newstate.l2 or newstate.select then press( 'time' ) end
  if newstate.left then press( 'left' ) end
  if newstate.right then press( 'right' ) end

  if newstate.pointer_pressed then
    local px, py = newstate.pointer_x, newstate.pointer_y
    for i = 1, #tapzones do
      local z = tapzones[ i ]
      if px >= z[1] and px < z[1]+z[3] and py >= z[2] and py < z[2]+z[4] then
        press( z[ 5 ] ); break
      end
    end
  end

  redges = 0
  acc = acc + CYCLES_PER_FRAME
  local n = acc // 1
  acc = acc - n
  cpu:run( n )

  if redges >= 4 then
    if not buzzing then system.playsound( snd, -1 ); buzzing = true end
  elseif buzzing then
    system.stopsounds( -1 ); buzzing = false
  end

  local segset = cpu:segments()
  for i = 1, #segdefs do
    segimgs[ i ].visible = segset[ segdefs[ i ][ 1 ] ] == true
  end

  return true
end
